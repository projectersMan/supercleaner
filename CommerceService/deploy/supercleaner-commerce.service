[Unit]
Description=SuperCleaner payment and license service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=supercleaner-commerce
Group=supercleaner-commerce
WorkingDirectory=/opt/supercleaner
ExecStart=/usr/bin/node /opt/supercleaner/CommerceService/server.mjs /etc/supercleaner-commerce/config.json
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/supercleaner-commerce
ReadOnlyPaths=/etc/supercleaner-commerce
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
